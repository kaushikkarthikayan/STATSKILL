# Copy this file to .env and fill in your values. Never commit or share .env.

# "sqlite" needs no install (default for local development).
# "postgres" uses PostgreSQL; set the DATABASE_* values below.
DB_ENGINE=sqlite
SQLITE_PATH=data/statskill.db

DATABASE_NAME=statskill_db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Generate one with:  py -3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters

ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_DAYS=14
RESET_TOKEN_MINUTES=30
PRINT_RESET_LINKS=true
FRONTEND_URL=http://127.0.0.1:5173

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=storage/resources
MAX_UPLOAD_MB=20
